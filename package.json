{
  "name": "@progfay/nextjs-ssg-rewrite-rule-gen",
  "version": "1.3.1",
  "description": "generate nginx rewrite rules for Next.js SSG (Pages Router)",
  "license": "MIT",
  "author": "progfay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/progfay/nextjs-ssg-rewrite-rule-gen.git"
  },
  "bin": {
    "nextjs-ssg-rewrite-rule-gen": "bin/nextjs-ssg-rewrite-rule-gen.js"
  },
  "files": [
    "bin",
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config && npm run build",
    "build": "vp pack",
    "generate": "./bin/nextjs-ssg-rewrite-rule-gen.js",
    "test": "vp test run",
    "lint": "vp check",
    "format": "vp check --fix"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.2"
}
